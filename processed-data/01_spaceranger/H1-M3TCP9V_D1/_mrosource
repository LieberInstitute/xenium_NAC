    in  h5                      raw_probe_bc_matrix_base_bin,
    in  bool                    is_pd,
    in  bi.bincode              barcode_index,
    in  int                     max_nucleus_diameter_px,
    out map<BinnedOutputs>      binned_outputs,
    out bool                    disable_binning,
    out map<int>                binning_scales,
