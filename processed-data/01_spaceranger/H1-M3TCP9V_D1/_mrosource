    in  json                    hd_layout_data_json,
    in  csf[]                   counts_bc_order,
    in  map<ChemistryDef>       chemistry_defs,
    in  string                  sample_id,
    in  string                  sample_desc,
    in  frf.bincode             slfe_feature_reference,
    in  json                    barcodes_under_tissue,
    in  bool                    no_secondary_analysis,
